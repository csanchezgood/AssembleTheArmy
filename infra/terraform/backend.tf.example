# Remote state. Copy to backend.tf, uncomment and adjust, then run
# `terraform init -migrate-state`. The bucket must exist
# beforehand (versioned bucket, SSE enabled). Locking uses use_lockfile.
#
# terraform {
#   backend "s3" {
#     bucket         = "my-terraform-state-bucket"
#     key            = "assemble-the-army/dev/terraform.tfstate"
#     region         = "us-east-1"
#     use_lockfile   = true
#     encrypt        = true
#   }
# }
